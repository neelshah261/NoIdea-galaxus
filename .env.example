# Copy to .env (git ignores it) and fill in. Never commit .env or paste keys in chat, issues or Discord.
# The first three names are the ones the template README asks for.

# TODO(owner): exact model id of Apertus v1.5 on the endpoint (Q-0001)
LLM_NAME=
# Hugging Face Inference Providers (OpenAI-compatible)
LLM_BASE_URL=https://router.huggingface.co/v1
# Key 1 is used first. When its credits run out (HTTP 402) or it is rejected (401), galaxus.keys switches to the next.
LLM_API_KEY=
LLM_API_KEY_2=
LLM_API_KEY_3=
LLM_API_KEY_4=
# Add LLM_API_KEY_5, _6, ... as needed. Empty ones are skipped.

# Absolute path of the competition data, outside the repo
GALAXUS_DATA=
